<?xml version="1.0"?>
<sdf version="1.6">
  <model name="vln_rover">
    <static>false</static>

    <link name="base_footprint">
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <inertial>
        <mass>18.0</mass>
        <inertia>
          <ixx>1.5</ixx>
          <iyy>2.0</iyy>
          <izz>2.5</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <collision name="chassis_collision">
        <pose>0 0 0.11 0 0 0</pose>
        <geometry>
          <box>
            <size>0.78 0.54 0.22</size>
          </box>
        </geometry>
      </collision>

      <visual name="chassis_visual">
        <pose>0 0 0.11 0 0 0</pose>
        <geometry>
          <box>
            <size>0.78 0.54 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.34 0.52 1</ambient>
          <diffuse>0.18 0.34 0.52 1</diffuse>
        </material>
      </visual>

      <visual name="mast_visual">
        <pose>0.18 0 0.33 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.12 0.24</size>
          </box>
        </geometry>
        <material>
          <ambient>0.70 0.72 0.75 1</ambient>
          <diffuse>0.70 0.72 0.75 1</diffuse>
        </material>
      </visual>

      <visual name="wheel_fl_visual">
        <pose>0.20 0.29 0.08 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>

      <visual name="wheel_fr_visual">
        <pose>0.20 -0.29 0.08 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>

      <visual name="wheel_rl_visual">
        <pose>-0.22 0.29 0.08 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>

      <visual name="wheel_rr_visual">
        <pose>-0.22 -0.29 0.08 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="camera_link">
      <pose>0.5 -0.04 0.57 0 0.314 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.08 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <sensor type="camera" name="front_rgb_camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera name="front_rgb">
          <horizontal_fov>2.0</horizontal_fov>
          <image>
            <width>1080</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>50.0</far>
          </clip>
        </camera>
        <plugin name="front_rgb_plugin" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>magv_camera</cameraName>
          <imageTopicName>/magv/camera/image_raw</imageTopicName>
          <cameraInfoTopicName>/magv/camera/camera_info</cameraInfoTopicName>
          <frameName>camera_optical_frame</frameName>
          <hackBaseline>0.0</hackBaseline>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>camera_link</child>
    </joint>

    <link name="lidar_link">
      <pose>0 0 0.25 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.84 1</ambient>
          <diffuse>0.82 0.82 0.84 1</diffuse>
        </material>
      </visual>

      <sensor type="depth" name="forward_depth_lidar">
        <always_on>true</always_on>
        <update_rate>8</update_rate>
        <camera name="depth_lidar_camera">
          <horizontal_fov>2.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>64</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.15</near>
            <far>18.0</far>
          </clip>
        </camera>
        <plugin name="depth_lidar_plugin" filename="libgazebo_ros_depth_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <cameraName>magv_depth_lidar</cameraName>
          <imageTopicName>/magv/lidar/rgb/image_raw</imageTopicName>
          <cameraInfoTopicName>/magv/lidar/rgb/camera_info</cameraInfoTopicName>
          <depthImageTopicName>/magv/lidar/depth/image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>/magv/lidar/depth/camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>/magv/scan/3d</pointCloudTopicName>
          <frameName>lidar_optical_frame</frameName>
          <hackBaseline>0.0</hackBaseline>
          <pointCloudCutoff>0.15</pointCloudCutoff>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>

      <sensor type="ray" name="planar_laser">
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>20.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <plugin name="planar_laser_plugin" filename="libgazebo_ros_laser.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>0.0</updateRate>
          <gaussianNoise>0.01</gaussianNoise>
          <topicName>/magv/scan/2d</topicName>
          <frameName>lidar_link</frameName>
        </plugin>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>lidar_link</child>
    </joint>

    <plugin name="planar_move_controller" filename="libgazebo_ros_planar_move.so">
      <robotNamespace>/</robotNamespace>
      <commandTopic>/magv/omni_drive_controller/cmd_vel</commandTopic>
      <odometryTopic>/magv/odometry/gt</odometryTopic>
      <odometryFrame>map</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <odometryRate>30.0</odometryRate>
      <cmdTimeout>0.5</cmdTimeout>
    </plugin>
  </model>
</sdf>
