<?xml version="1.0"?>
<launch>
    <arg name="use_sim_time" default="false"/>
    <arg name="vlm_backend" default="qwen"/>
    <arg name="vlm_model_path" default="$(optenv VLN_QWEN_MODEL_PATH /var/tmp/vln_models/Qwen--Qwen2-VL-2B-Instruct)"/>
    <arg name="grounding_backend" default="grounding_dino"/>
    <arg name="grounding_model_path" default="$(optenv VLN_GROUNDING_MODEL_PATH /var/tmp/vln_models/grounding-dino-base)"/>
    <arg name="grounding_fallback_model_path" default="$(arg vlm_model_path)"/>
    <arg name="image_topic" default="/magv/camera/image_compressed/compressed"/>
    <arg name="pointcloud_topic" default="/magv/scan/3d"/>
    <arg name="odometry_topic" default="/magv/odometry/gt"/>
    <arg name="cmd_vel_topic" default="/magv/omni_drive_controller/cmd_vel"/>
    <arg name="world_goal_topic" default="/world_goal"/>
    <arg name="body_goal_topic" default="/body_goal"/>
    <arg name="velocity_goal_topic" default="/velocity_goal"/>
    <arg name="path_point_topic" default="/path_point"/>
    <arg name="base_frame" default="base_footprint"/>
    <arg name="alias_base_frame" default="magv/base_link"/>
    <arg name="map_frame" default="map"/>
    <arg name="enable_odom_tf_broadcaster" default="true"/>

    <param name="use_sim_time" value="$(arg use_sim_time)"/>

    <node name="instruction_latch_bridge" pkg="vln_mock" type="instruction_latch_bridge.py" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/instruction_latch_bridge.yaml"/>
    </node>

    <node name="pointcloud_to_grid_node" pkg="pointcloud_to_grid" type="pointcloud_to_grid_node" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/pointcloud_to_grid.yaml"/>
        <param name="cloud_in_topic" value="$(arg pointcloud_topic)"/>
        <param name="mapi_topic_name" value="/occupancy_grid"/>
        <param name="frame_out" value="$(arg map_frame)"/>
    </node>

    <node name="aruco_detector_node" pkg="aruco_detector" type="aruco_node.py" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/aruco_detector.yaml"/>
        <param name="image_topic" value="$(arg image_topic)"/>
        <param name="output_frame_id" value="$(arg base_frame)"/>
    </node>

    <node name="vlm_loader" pkg="llm_model" type="vlm_loader.py" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/vlm_loader.yaml"/>
        <param name="backend" value="$(arg vlm_backend)"/>
        <param name="model_path" value="$(arg vlm_model_path)"/>
        <param name="default_florence_model_path" value="$(find llm_model)/models/microsoft--Florence-2-large"/>
        <param name="image_topic" value="$(arg image_topic)"/>
    </node>

    <node name="ins_processor" pkg="llm_model" type="ins_processor.py" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/ins_processor.yaml"/>
    </node>

    <node name="grounding_dino_node" pkg="llm_model" type="grounding_dino_node.py" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/grounding_dino.yaml"/>
        <param name="backend" value="$(arg grounding_backend)"/>
        <param name="model_path" value="$(arg grounding_model_path)"/>
        <param name="fallback_model_path" value="$(arg grounding_fallback_model_path)"/>
        <param name="image_topic" value="$(arg image_topic)"/>
        <param name="odometry_topic" value="$(arg odometry_topic)"/>
        <param name="vln_status_topic" value="/vln_status"/>
        <param name="prompt_topic" value="/grounding_dino/prompt"/>
        <param name="detections_topic" value="/grounding_dino/detections"/>
    </node>

    <node name="vehicle_status_manager" pkg="vln_mock" type="vehicle_status_manager.py" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/vehicle_status_manager.yaml"/>
        <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
        <param name="odometry_topic" value="$(arg odometry_topic)"/>
        <param name="pointcloud_topic" value="$(arg pointcloud_topic)"/>
        <param name="world_goal_topic" value="$(arg world_goal_topic)"/>
        <param name="base_frame" value="$(arg base_frame)"/>
    </node>

    <node if="$(arg enable_odom_tf_broadcaster)" name="odom_tf_broadcaster" pkg="vln_mock" type="odom_tf_broadcaster.py" output="screen">
        <param name="odometry_topic" value="$(arg odometry_topic)"/>
        <param name="default_child_frame_id" value="$(arg base_frame)"/>
        <param name="alias_child_frame_id" value="$(arg alias_base_frame)"/>
    </node>

    <node name="controller" pkg="vln_mock" type="controller.py" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/controller.yaml"/>
        <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
        <param name="odometry_topic" value="$(arg odometry_topic)"/>
        <param name="world_goal_topic" value="$(arg world_goal_topic)"/>
        <param name="body_goal_topic" value="$(arg body_goal_topic)"/>
        <param name="velocity_goal_topic" value="$(arg velocity_goal_topic)"/>
        <param name="path_point_topic" value="$(arg path_point_topic)"/>
    </node>

    <node name="core_node" pkg="vln_mock" type="core_node.py" output="screen">
        <rosparam command="load" file="$(find vln_mock)/config/core_node.yaml"/>
        <param name="world_goal_topic" value="$(arg world_goal_topic)"/>
        <param name="body_goal_topic" value="$(arg body_goal_topic)"/>
        <param name="velocity_goal_topic" value="$(arg velocity_goal_topic)"/>
        <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
        <param name="occupancy_grid_topic" value="/occupancy_grid"/>
        <param name="aruco_info_topic" value="/aruco_info"/>
        <param name="image_topic" value="$(arg image_topic)"/>
        <param name="odometry_topic" value="$(arg odometry_topic)"/>
        <param name="grounding_detections_topic" value="/grounding_dino/detections"/>
        <param name="path_point_topic" value="$(arg path_point_topic)"/>
    </node>

    <!-- <node name="rviz" pkg="rviz" type="rviz" output="screen" required="false"/> -->
</launch>
